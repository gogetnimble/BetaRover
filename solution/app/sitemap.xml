<?xml version="1.0" encoding="utf-8"?>
<!--
  Ember model-driven app — site map.

  Every menu item opens the SAME web resource (bvr_flowreview_app.html) with a
  different ?data= value. The web resource reads it on load (init → PAGE_MAP)
  and shows that section, so the native left-nav drives the whole Ember UI:

     Dashboard        -> ?data=dash
     Flow Inventory   -> ?data=flowinventory
     Review Runs      -> ?data=reviewruns
     Flow Reviews     -> ?data=flowreviews
     Findings         -> ?data=findings
     Test Coverage    -> ?data=testcoverage
     Test Cases       -> ?data=testcases
     Test Runs        -> ?data=testruns
     Review Standards -> ?data=standards
     Review Rules     -> ?data=rules
     Crawl Schedule   -> ?data=schedule
     License          -> ?data=license
     Getting Started  -> bvr_gettingstarted.html   (a separate web resource)

  Web-resource subareas take a query string on the /WebResources/ URL form
  (the $webresource: token form does not), which is why each Url is written out
  in full. See solution/app/README.md for how to apply this.
-->
<SiteMap>
  <Area Id="ember_area" ShowGroups="true">
    <Titles><Title LCID="1033" Title="Ember" /></Titles>
    <Group Id="review_group">
      <Titles><Title LCID="1033" Title="Review" /></Titles>
      <SubArea Id="sa_dashboard" Url="/WebResources/bvr_flowreview_app.html?data=dash">
        <Titles><Title LCID="1033" Title="Dashboard" /></Titles></SubArea>
      <SubArea Id="sa_flowinventory" Url="/WebResources/bvr_flowreview_app.html?data=flowinventory">
        <Titles><Title LCID="1033" Title="Flow Inventory" /></Titles></SubArea>
      <SubArea Id="sa_reviewruns" Url="/WebResources/bvr_flowreview_app.html?data=reviewruns">
        <Titles><Title LCID="1033" Title="Review Runs" /></Titles></SubArea>
      <SubArea Id="sa_flowreviews" Url="/WebResources/bvr_flowreview_app.html?data=flowreviews">
        <Titles><Title LCID="1033" Title="Flow Reviews" /></Titles></SubArea>
      <SubArea Id="sa_findings" Url="/WebResources/bvr_flowreview_app.html?data=findings">
        <Titles><Title LCID="1033" Title="Findings" /></Titles></SubArea>
    </Group>
    <Group Id="unittest_group">
      <Titles><Title LCID="1033" Title="Unit Testing" /></Titles>
      <SubArea Id="sa_testcoverage" Url="/WebResources/bvr_flowreview_app.html?data=testcoverage">
        <Titles><Title LCID="1033" Title="Test Coverage" /></Titles></SubArea>
      <SubArea Id="sa_testcases" Url="/WebResources/bvr_flowreview_app.html?data=testcases">
        <Titles><Title LCID="1033" Title="Test Cases" /></Titles></SubArea>
      <SubArea Id="sa_testruns" Url="/WebResources/bvr_flowreview_app.html?data=testruns">
        <Titles><Title LCID="1033" Title="Test Runs" /></Titles></SubArea>
    </Group>
    <Group Id="config_group">
      <Titles><Title LCID="1033" Title="Configuration" /></Titles>
      <SubArea Id="sa_standards" Url="/WebResources/bvr_flowreview_app.html?data=standards">
        <Titles><Title LCID="1033" Title="Review Standards" /></Titles></SubArea>
      <SubArea Id="sa_rules" Url="/WebResources/bvr_flowreview_app.html?data=rules">
        <Titles><Title LCID="1033" Title="Review Rules" /></Titles></SubArea>
      <SubArea Id="sa_schedule" Url="/WebResources/bvr_flowreview_app.html?data=schedule">
        <Titles><Title LCID="1033" Title="Crawl Schedule" /></Titles></SubArea>
      <SubArea Id="sa_license" Url="/WebResources/bvr_flowreview_app.html?data=license">
        <Titles><Title LCID="1033" Title="License" /></Titles></SubArea>
      <SubArea Id="sa_gettingstarted" Url="/WebResources/bvr_gettingstarted.html">
        <Titles><Title LCID="1033" Title="Getting Started" /></Titles></SubArea>
    </Group>
  </Area>
</SiteMap>
