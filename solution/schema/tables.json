{
  "publisher": {
    "prefix": "br",
    "name": "BetaRover",
    "description": "Publisher prefix for the Flow Code Review solution. Change to match your own publisher before deploying."
  },
  "solution": {
    "uniqueName": "BetaRoverFlowReview",
    "friendlyName": "BetaRover Flow Code Review"
  },
  "note": "Deployable specification for the Dataverse tables. Author these via the maker portal, `pac`, or a deployment script. Choice option-set values are illustrative; adjust to your org's conventions.",
  "tables": [
    {
      "schemaName": "br_reviewstandard",
      "displayName": "Review Standard",
      "primaryColumn": "br_name",
      "description": "A named, versioned collection of review rules. One row per delivery standard.",
      "columns": [
        { "schemaName": "br_name", "type": "Text", "maxLength": 200, "required": true, "isPrimary": true },
        { "schemaName": "br_code", "type": "Text", "maxLength": 50, "required": true, "description": "Stable code, e.g. CMA-PA-STD." },
        { "schemaName": "br_version", "type": "Text", "maxLength": 20 },
        { "schemaName": "br_standardtext", "type": "Multiline", "maxLength": 100000, "description": "Human-readable standard, passed to the AI reviewer for context." },
        { "schemaName": "br_isactive", "type": "Boolean", "default": true }
      ]
    },
    {
      "schemaName": "br_reviewrule",
      "displayName": "Review Rule",
      "primaryColumn": "br_name",
      "description": "A single configurable review criterion. The engine evaluates enabled rules against every flow.",
      "columns": [
        { "schemaName": "br_name", "type": "Text", "maxLength": 200, "required": true, "isPrimary": true },
        { "schemaName": "br_code", "type": "Text", "maxLength": 50, "required": true, "description": "Machine code, e.g. NAMING_CONVENTION." },
        { "schemaName": "br_category", "type": "Choice", "options": ["Naming", "ErrorHandling", "Logging", "Configuration", "Security", "Email", "General"] },
        { "schemaName": "br_evaluator", "type": "Text", "maxLength": 100, "description": "Deterministic evaluator key, or 'ai' to defer to the AI pass." },
        { "schemaName": "br_severity", "type": "Choice", "options": ["info", "warning", "error", "critical"] },
        { "schemaName": "br_enabled", "type": "Boolean", "default": true },
        { "schemaName": "br_weight", "type": "WholeNumber", "min": 0, "max": 100, "default": 1 },
        { "schemaName": "br_parametersjson", "type": "Multiline", "maxLength": 10000, "description": "JSON parameters for the evaluator (prefix, approved senders, scope names, ...)." },
        { "schemaName": "br_remediation", "type": "Multiline", "maxLength": 4000 },
        { "schemaName": "br_description", "type": "Multiline", "maxLength": 4000 },
        { "schemaName": "br_standardid", "type": "Lookup", "target": "br_reviewstandard", "required": true }
      ]
    },
    {
      "schemaName": "br_flowinventory",
      "displayName": "Flow Inventory",
      "primaryColumn": "br_name",
      "description": "One row per discovered cloud flow. Populated by the crawl from the Dataverse workflows table and enriched from the Power Automate Management API.",
      "columns": [
        { "schemaName": "br_name", "type": "Text", "maxLength": 300, "required": true, "isPrimary": true, "description": "Flow display name (workflows.name)." },
        { "schemaName": "br_flowid", "type": "Text", "maxLength": 50, "description": "workflowid GUID (unique key)." },
        { "schemaName": "br_environment", "type": "Text", "maxLength": 200 },
        { "schemaName": "br_ownertype", "type": "Choice", "options": ["user", "application", "team", "unknown"] },
        { "schemaName": "br_ownername", "type": "Text", "maxLength": 200 },
        { "schemaName": "br_state", "type": "Choice", "options": ["Draft", "Activated", "Suspended"] },
        { "schemaName": "br_solution", "type": "Text", "maxLength": 200 },
        { "schemaName": "br_source", "type": "Choice", "options": ["dataverse", "managementapi", "both"] },
        { "schemaName": "br_lastmodifiedon_src", "type": "DateTime", "description": "modifiedon of the source flow." },
        { "schemaName": "br_definitionhash", "type": "Text", "maxLength": 64, "description": "Hash of clientdata to detect changes between runs." },
        { "schemaName": "br_triggertype", "type": "Text", "maxLength": 100 },
        { "schemaName": "br_actioncount", "type": "WholeNumber" }
      ],
      "alternateKeys": [{ "name": "br_flowid_key", "columns": ["br_flowid"] }]
    },
    {
      "schemaName": "br_reviewrun",
      "displayName": "Review Run",
      "primaryColumn": "br_name",
      "description": "One crawl + review execution. Parent of the per-flow reviews.",
      "columns": [
        { "schemaName": "br_name", "type": "Text", "maxLength": 200, "required": true, "isPrimary": true, "description": "e.g. 'Crawl 2026-08-04 06:00'." },
        { "schemaName": "br_startedon", "type": "DateTime" },
        { "schemaName": "br_completedon", "type": "DateTime" },
        { "schemaName": "br_status", "type": "Choice", "options": ["Queued", "Running", "Completed", "Failed"] },
        { "schemaName": "br_standardid", "type": "Lookup", "target": "br_reviewstandard" },
        { "schemaName": "br_flowsscanned", "type": "WholeNumber" },
        { "schemaName": "br_findingscount", "type": "WholeNumber" },
        { "schemaName": "br_averagescore", "type": "Decimal", "precision": 2 },
        { "schemaName": "br_triggeredby", "type": "Text", "maxLength": 200 }
      ]
    },
    {
      "schemaName": "br_flowreview",
      "displayName": "Flow Review",
      "primaryColumn": "br_name",
      "description": "The review of one flow within one run. Parent of the findings; carries the per-flow score.",
      "columns": [
        { "schemaName": "br_name", "type": "Text", "maxLength": 400, "required": true, "isPrimary": true },
        { "schemaName": "br_runid", "type": "Lookup", "target": "br_reviewrun", "required": true },
        { "schemaName": "br_flowinventoryid", "type": "Lookup", "target": "br_flowinventory", "required": true },
        { "schemaName": "br_score", "type": "WholeNumber", "min": 0, "max": 100 },
        { "schemaName": "br_passed", "type": "WholeNumber" },
        { "schemaName": "br_failed", "type": "WholeNumber" },
        { "schemaName": "br_warnings", "type": "WholeNumber" },
        { "schemaName": "br_status", "type": "Choice", "options": ["Pass", "Warning", "Fail"] }
      ]
    },
    {
      "schemaName": "br_reviewfinding",
      "displayName": "Review Finding",
      "primaryColumn": "br_name",
      "description": "A single rule outcome for a single flow in a single run.",
      "columns": [
        { "schemaName": "br_name", "type": "Text", "maxLength": 400, "required": true, "isPrimary": true, "description": "Auto-numberable, e.g. '<flow> - <ruleCode>'." },
        { "schemaName": "br_flowreviewid", "type": "Lookup", "target": "br_flowreview", "required": true },
        { "schemaName": "br_ruleid", "type": "Lookup", "target": "br_reviewrule" },
        { "schemaName": "br_rulecode", "type": "Text", "maxLength": 50 },
        { "schemaName": "br_status", "type": "Choice", "options": ["pass", "warning", "fail", "not_applicable"] },
        { "schemaName": "br_severity", "type": "Choice", "options": ["info", "warning", "error", "critical"] },
        { "schemaName": "br_category", "type": "Choice", "options": ["Naming", "ErrorHandling", "Logging", "Configuration", "Security", "Email", "General"] },
        { "schemaName": "br_message", "type": "Multiline", "maxLength": 4000 },
        { "schemaName": "br_evidence", "type": "Multiline", "maxLength": 4000 },
        { "schemaName": "br_remediation", "type": "Multiline", "maxLength": 4000 },
        { "schemaName": "br_aigenerated", "type": "Boolean", "default": false }
      ]
    }
  ]
}
